# Enter values in Dokploy -> Frappe Compose -> Environment.
# Never reuse the other ERPNext installation's password or volumes.
# Change the image to the immutable run-<id> tag after GitHub Actions succeeds.
FRAPPE_SUITE_IMAGE=ghcr.io/ben-001-sys/cetech-frappeverse:run-REPLACE_WITH_SUCCESSFUL_RUN_ID
SUITE_DB_PASSWORD=REPLACE_WITH_A_NEW_LONG_RANDOM_SECRET
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
# Do not set FRAPPE_SITE_NAME_HEADER when the Bench site matches its public domain.
