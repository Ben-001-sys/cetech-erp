# Reference only. Never commit a real .env file or production credentials.
# Paste these into Dokploy -> ERPNext Compose service -> Environment.
# Keep all sensitive values out of GitHub.
ERPNEXT_VERSION=v16.50.0
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional performance and request settings; the Compose file provides defaults:
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
# Intended site: erpnext.benuel.dedyn.io (created once with bench new-site).
# Keep FRAPPE_SITE_NAME_HEADER unset because the Bench site name matches the hostname.
